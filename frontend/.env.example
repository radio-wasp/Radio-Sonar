# ==============================================================================
# Stingray BIC Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Cloud AI Transcription & Brand Extraction
# If omitted, Stingray BIC runs completely offline using local Whisper & regex NER.
# ------------------------------------------------------------------------------

# Groq Cloud API (Recommended: Free tier, near-instant ~300ms transcription)
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# OpenAI API (Optional: Whisper API + GPT-4o-mini)
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Anthropic API (Optional: Claude 3.5 Haiku)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local Whisper Settings (When running without Cloud APIs)
# ------------------------------------------------------------------------------
# Models: 'tiny' (~75MB, fastest), 'base' (~140MB), 'small' (~460MB)
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=en

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
